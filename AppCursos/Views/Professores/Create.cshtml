@model AppCursos.Models.Professor

@{
    ViewData["Title"] = "Cadastrar novo aluno";
}

<h1 class="display-5 text-center">Cadastrar Novo Professor</h1>

<div class="container border border-2 rounded-4 bg-secondary p-5 shadow text-white">
    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="row">
            <div class="col-12 col-md-12 mb-3">
            <div class="form-group">
                <label asp-for="Nome" class="control-label"></label>
                <input asp-for="Nome" class="form-control" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>
            </div>

            <div class="col-12 col-md-6 mb-3">
            <div class="form-group">
                <label asp-for="Email" class="control-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            </div>

            <div class="col-12 col-md-6 mb-3">
            <div class="form-group">
                <label asp-for="Salario" class="control-label"></label>
                <input asp-for="Salario" class="form-control" />
                <span asp-validation-for="Salario" class="text-danger"></span>
            </div>
            </div>
            <div class="col-6">
            <div class="form-group">
            </div>
                <input type="submit" value="Salvar" class="btn btn-primary w-100" />
            
        
    </div>
     <div class="col-6">

        <a asp-action="Index" class="btn btn-dark w-100">Cancelar</a>
    </form>
</div>
</div>
